// =============================================================================
// Proxmox Backup GUI — Fast pipeline
// Trigger : GitHub webhook (every push)
// Runtime : ~90s on Jenkins LXC, no VM needed
// Tests   : Unit tests (backend logic) + Playwright mock-server tests
// =============================================================================

pipeline {
    agent any

    parameters {
        string(name: 'BRANCH', defaultValue: 'main',
               description: 'Branch to test (e.g. main, feature/backup-restore)')
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        ansiColor('xterm')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scmGit(
                    branches: [[name: "${params.BRANCH}"]],
                    userRemoteConfigs: scm.userRemoteConfigs
                )
                echo "Testing branch: ${params.BRANCH}"
            }
        }

        stage('Install deps') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/pip install -q -r requirements.txt
                    .venv/bin/pip install -q pytest pytest-cov playwright
                    .venv/bin/playwright install chromium
                '''
            }
        }

        stage('Unit tests') {
            steps {
                // Coverage gate: unit tests must keep backend coverage above the
                // threshold (ratchet). Catches untested code paths — e.g. an agent
                // feature added without a unit test (which is how the settings
                // MQTT port slipped through before). Raise COV_MIN as coverage grows.
                sh '''
                    mkdir -p test-results
                    PYTHONUNBUFFERED=1 \
                    .venv/bin/pytest ci/tests/test_unit.py ci/tests/test_auth.py \
                        ci/tests/test_pve_agent.py \
                        ci/tests/test_mqtt.py \
                        ci/tests/test_mqtt_manager.py \
                        -v --tb=short --no-header --color=yes \
                        --junit-xml=test-results/unit.xml \
                        --cov=backend \
                        --cov-report=term-missing:skip-covered \
                        --cov-report=xml:test-results/coverage.xml \
                        --cov-report=html:test-results/htmlcov \
                        --cov-fail-under=50
                '''
            }
        }

        stage('Mock tests') {
            steps {
                sh '''
                    PYTHONUNBUFFERED=1 \
                    .venv/bin/pytest ci/tests/test_frontend.py \
                        -v --tb=short --no-header --color=yes \
                        --junit-xml=test-results/frontend-mock.xml
                '''
            }
        }
    }

    post {
        always {
            junit 'test-results/unit.xml, test-results/frontend-mock.xml'
            // Coverage report (HTML for humans, Cobertura XML for trend graphs if
            // the Cobertura/Coverage plugin is installed). Archived before cleanup.
            archiveArtifacts artifacts: 'test-results/coverage.xml, test-results/htmlcov/**',
                             allowEmptyArchive: true, fingerprint: false
            cleanWs()
        }
        success { echo "All tests passed — safe to merge" }
        failure { echo "Tests failed — check test-results/" }
    }
}
